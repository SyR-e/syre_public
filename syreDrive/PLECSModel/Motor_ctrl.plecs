  Script {
    Name          "Initialitation"
    Script        "load('SimMatFiles\\UserSettings.mat');\n\nInverterModel=1; "
" %0:Average Model %1:Switching \n%FMapsModel=-1;\t\t%1: dq Model -1:dqt Model"
"\n%IronLoss = 0;\t\t%0: No loss model 1:loss model included\n\nswitch(Inverte"
"rModel)\n\tcase 1\n\t\tplecs('set', './Inverter Model/Command Configuration',"
" 'Configuration', 'Istantaneous Model');\n\tcase 0\n\t\tplecs('set', './Inver"
"ter Model/Command Configuration', 'Configuration', 'Average Model');\nend\n\n"
"switch(IronLoss)\n\tcase 0\n\t\tplecs('set', './Motor Model/Circuital Model/I"
"ron Loss Model', 'Configuration', 'No Iron losses');\n\tcase 1\n\t\tplecs('se"
"t', './Motor Model/Circuital Model/Iron Loss Model', 'Configuration', 'Iron l"
"osses');\nend\n\n\n\nif(Quad_Maps==0 && FMapsModel==1)\n\tplecs('set', './Mot"
"or Model/Circuital Model/Inverse Flux Maps', 'Configuration', 'dq model - SyR"
"');\nend\n\nif(Quad_Maps==1 && FMapsModel==1)\n\tplecs('set', './Motor Model/"
"Circuital Model/Inverse Flux Maps', 'Configuration', 'dq model - PM-SyR');\ne"
"nd\n\nif(Quad_Maps==2 && FMapsModel==1)\t\n\tplecs('set', './Motor Model/Circ"
"uital Model/Inverse Flux Maps', 'Configuration', 'dq model - PM');\nend\t\n\n"
"if(Quad_Maps==0 && FMapsModel==-1)\n\tplecs('set', './Motor Model/Circuital M"
"odel/Inverse Flux Maps', 'Configuration', 'dqt model - SyR');\nend\n\nif(Quad"
"_Maps==1 && FMapsModel==-1)\n\tplecs('set', './Motor Model/Circuital Model/In"
"verse Flux Maps', 'Configuration', 'dqt model - PM-SyR');\nend\n\nif(Quad_Map"
"s==2 && FMapsModel==-1)\t\n\tplecs('set', './Motor Model/Circuital Model/Inve"
"rse Flux Maps', 'Configuration', 'dqt model - PM');\nend"
  }
  Script {
    Name          "TimeCalculation"
    Script        "tic\nplecs('simulate')\ntoc"
  }
}
