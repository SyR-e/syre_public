"s\\InvFluxMapdqt');\nload('SimMatFiles\\Parameters');\nload('SimMatFiles\\Use"
"rSettings');\nload('SimMatFiles\\IronLosses');\n\n\nswitch(Quad_Maps)\n\n\tca"
"se 0\t%SyR\n\t\td_init = 0;\n\t\tq_init = 0;\n\t\n\tcase 1\t%PM-SyR\n\t\td_in"
"it = Fm*sin(th0);\n\t\tq_init = -Fm*cos(th0);\t\n\t\n\tcase 2\t%PM\n\t\td_ini"
"t = Fm*cos(th0);\n\t\tq_init = Fm*sin(th0);\nend\n"
