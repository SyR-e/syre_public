"\n"
"th_deg = (th_rad*180)/PI;\n"
"\n"
"while(th_deg>360){\n"
"\tth_deg = th_deg -360;\n"
"}\n"
"\n"
"while (th_deg<0){\n"
"\tth_deg = th_deg +360;\n"
"}\n"
"\n"
"\n"
"\n"
"\n"
"OutputSignal(0,0) = th_deg;"
