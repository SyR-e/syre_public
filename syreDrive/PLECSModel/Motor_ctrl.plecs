                        Parameter {
                          Variable      "Declarations"
                          Value         "#include<math.h>\n"
"\n"
"float idq_out_q;\n"
"float idq_out_d;\n"
"int Quad_Maps;\n"
"float idq_d;\n"
"float idq_q;\n"
                          Show          off
                        }
                        Parameter {
                          Variable      "StartFcn"
                          Value         ""
                          Show          off
                        }
                        Parameter {
                          Variable      "OutputFcn"
                          Value         "idq_d=InputSignal(0,0);\n"
"idq_q=InputSignal(0,1);\n"
"Quad_Maps=InputSignal(0,2);\n"
"\n"
"switch(Quad_Maps){\n"
"  case 0: //SyR\n"
"        idq_out_d = fabs(idq_d);\n"
"        idq_out_q = fabs(idq_q);\n"
"  break;\n"
"  case 1:  //PM-SyR\n"
"        idq_out_d = fabs(idq_d);\n"
"        idq_out_q = idq_q;\n"
"  break;\n"
"    \n"
"  case 2:  //PM  \n"
"        idq_out_d = idq_d;\n"
"        idq_out_q= fabs(idq_q);\n"
"  break;\n"
"}\n"
"\n"
"OutputSignal(0,0) = idq_out_d;\n"
"OutputSignal(0,1) = idq_out_q;\n"
                          Show          off
                        }
