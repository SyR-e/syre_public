                        Parameter {
                          Variable      "Declarations"
                          Value         "#define PI 3.1415926f\n"
"float P;\n"
"float Fd;\n"
"float Fq;\n"
"float n;\n"
"float pp;\n"
"float Id_fe, Iq_fe;\n"
"float tmp1,tmp2,tmp3;\n"
"\n"
"#include <math.h>\n"
"\n"
                          Show          off
                        }
                        Parameter {
                          Variable      "StartFcn"
                          Value         ""
                          Show          off
                        }
                        Parameter {
                          Variable      "OutputFcn"
                          Value         "P=InputSignal(0,0);\n"
"Fd=InputSignal(0,1);\n"
"Fq=InputSignal(0,2);\n"
"n=InputSignal(0,3);\n"
"pp=InputSignal(0,4);\n"
"\n"
"if (fabs(n)>0.1){\n"
"\ttmp1 = (n*PI*pp)/30;\n"
"\ttmp2 = Fd*Fd+Fq*Fq;\n"
"\ttmp3 = tmp1*tmp2;\t\n"
"\tId_fe = (P/tmp3)*(-Fq);\n"
"\tIq_fe = (P/tmp3)*(Fd);\n"
"}\n"
"else{\n"
"\tId_fe =0.0f;\n"
"\tIq_fe =0.0f;\n"
"}\n"
"\n"
"\n"
"OutputSignal(0,0)= Id_fe;\n"
"OutputSignal(0,1)= Iq_fe;\n"
"\n"
                          Show          off
                        }
